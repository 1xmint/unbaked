{
  "unbaked": 0,
  "output": {
    "kind": "video",
    "width": 48,
    "height": 32,
    "fps": "10",
    "duration_ms": 1000
  },
  "assets": {
    "gradient": {
      "path": "assets/gradient.png"
    }
  },
  "layers": [
    {
      "id": "fader",
      "type": "image",
      "asset": "gradient",
      "width": 24,
      "start_ms": 150,
      "end_ms": 850,
      "in": {
        "type": "fade",
        "duration_ms": 250,
        "ease": "ease-out"
      },
      "out": {
        "type": "zoom",
        "duration_ms": 200
      },
      "transform": {
        "x": 24,
        "y": 20,
        "anchor_x": 0.5,
        "anchor_y": 0.5
      }
    },
    {
      "id": "bar",
      "type": "solid",
      "color": "#ffffffff",
      "width": 8,
      "height": 8,
      "transform": {
        "x": {
          "keys": [
            {
              "t_ms": 0,
              "v": 0,
              "ease": "ease-in-out"
            },
            {
              "t_ms": 600,
              "v": 40,
              "ease": "hold"
            },
            {
              "t_ms": 800,
              "v": 20
            }
          ]
        },
        "y": 8,
        "anchor_x": 0.5,
        "anchor_y": 0.5,
        "rotation_deg": {
          "keys": [
            {
              "t_ms": 0,
              "v": 0,
              "ease": [
                0.3,
                -0.6,
                0.7,
                1.6
              ]
            },
            {
              "t_ms": 1000,
              "v": 90
            }
          ]
        }
      }
    },
    {
      "id": "slider",
      "type": "solid",
      "color": "#00c0ffc0",
      "width": 12,
      "height": 6,
      "transform": {
        "x": 30,
        "y": 2
      },
      "start_ms": 100,
      "end_ms": 900,
      "in": {
        "type": "slide-left",
        "duration_ms": 300
      },
      "out": {
        "type": "slide-down",
        "duration_ms": 300,
        "ease": "ease-in"
      }
    },
    {
      "id": "group",
      "type": "group",
      "start_ms": 300,
      "end_ms": 700,
      "in": {
        "type": "slide-up",
        "duration_ms": 200,
        "ease": "ease"
      },
      "out": {
        "type": "slide-right",
        "duration_ms": 150
      },
      "layers": [
        {
          "id": "dot",
          "type": "solid",
          "color": "#ff4040ff",
          "width": 6,
          "height": 6,
          "transform": {
            "x": 2,
            "y": 22
          },
          "opacity": {
            "keys": [
              {
                "t_ms": 0,
                "v": 1
              },
              {
                "t_ms": 300,
                "v": 0.2
              }
            ]
          }
        },
        {
          "id": "late-dot",
          "type": "solid",
          "color": "#40ff40ff",
          "width": 6,
          "height": 6,
          "transform": {
            "x": 10,
            "y": 22
          },
          "start_ms": 200,
          "end_ms": 400
        }
      ]
    }
  ]
}
